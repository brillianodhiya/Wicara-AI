# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# API Keys (for development only, not needed in production)
NEXT_PUBLIC_ASSEMBLYAI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# Encryption Key (should be a strong random string in production)
NEXT_PUBLIC_ENCRYPTION_KEY=wicara-ai-secure-encryption-key-dev-only
